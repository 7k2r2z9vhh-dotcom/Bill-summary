            <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
              <h2 style={{color:"var(--hawk-gold)",fontFamily:"Cinzel",fontWeight:700,fontSize:17,letterSpacing:1}}>🛡️ REGIMENT DIVISIONS</h2>
              <button onClick={()=>{setShowCatModal(false);setEditCat(null);setCatForm({name:"",color:"#d4af37"});}} style={{background:"var(--surface-falcon)",color:"var(--text-muted)",border:"none",borderRadius:4,width:30,height:30,cursor:"pointer",fontSize:14}}>✕</button>
            </div>
            <div style={{background:"var(--surface-falcon)",borderRadius:4,padding:16,marginBottom:20,border:"1px solid var(--border-steel)"}}>
              <div style={{color:"var(--text-muted)",fontSize:11,textTransform:"uppercase",letterSpacing:0.5,marginBottom:8}}>{editCat!==null?"RESTRUCTURE DIVISION":"ENLIST NEW REGIMENT DIVISION"}</div>
              <input value={catForm.name} placeholder="e.g. Heavy Cavalry, Rations..." onChange={e=>setCatForm({...catForm,name:e.target.value})} style={{width:"100%",background:"var(--bg-knight)",border:"1px solid var(--border-steel)",borderRadius:4,padding:"10px 12px",color:"var(--text-silver)",fontSize:14,outline:"none",marginBottom:14}}/>
              <div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:14}}>
                {PRESET_COLORS.map(c=><button key={c} onClick={()=>setCatForm({...catForm,color:c})} style={{width:26,height:26,borderRadius:"50%",background:c,border:catForm.color===c?"3px solid var(--text-silver)":"2px solid transparent",cursor:"pointer",transition:"transform 0.1s ease"}} onMouseOver={e=>e.target.style.transform="scale(1.15)"} onMouseOut={e=>e.target.style.transform="scale(1)"}/>)}
              </div>
              <div style={{display:"flex",alignItems:"center",gap:10,marginBottom:16}}>
                <span style={{color:"var(--text-muted)",fontSize:11}}>Insignia Preview:</span>
                <span style={{background:`${catForm.color}15`,color:catForm.color,borderRadius:2,padding:"4px 12px",fontSize:11,fontWeight:600,border:`1px solid ${catForm.color}66`,letterSpacing:1}}>{catForm.name.toUpperCase()||"NEW DIVISION"}</span>
              </div>
              <div style={{display:"flex",gap:8}}>
                {editCat!==null&&<button onClick={()=>{setEditCat(null);setCatForm({name:"",color:"#d4af37"});}} style={{flex:1,background:"var(--bg-knight)",color:"var(--text-muted)",border:"1px solid var(--border-steel)",borderRadius:4,padding:"10px 0",fontSize:12,fontWeight:600,cursor:"pointer"}}>CANCEL</button>}
                <button onClick={saveCat} style={{flex:2,background:"rgba(212,175,55,0.15)",color:"var(--hawk-gold)",border:"1px solid var(--hawk-gold)",borderRadius:4,padding:"10px 0",fontSize:12,fontWeight:700,letterSpacing:0.5,cursor:"pointer"}}>{editCat!==null?"CONFIRM ALTERATION":"+ ENLIST DIVISION"}</button>
              </div>
            </div>
            <div style={{color:"var(--text-muted)",fontSize:10,letterSpacing:1,textTransform:"uppercase",marginBottom:10}}>Active Regiments ({cats.length})</div>
            {cats.map((c,idx)=>(
              <div key={idx} style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"12px 14px",background:editCat===idx?"var(--surface-hawk)":"rgba(255,255,255,0.01)",borderRadius:4,marginBottom:6,border:editCat===idx?"1px solid var(--hawk-gold)":"1px solid var(--border-steel)"}}>
                <span style={{background:`${c.color}15`,color:c.color,borderRadius:2,padding:"4px 12px",fontSize:11,fontWeight:600,border:`1px solid ${c.color}55`,letterSpacing:1}}>{c.name.toUpperCase()}</span>
                <div style={{display:"flex",gap:6}}>
                  <button onClick={()=>openEditCat(idx)} style={{background:"var(--surface-falcon)",color:"#60a5fa",border:"1px solid rgba(96,165,250,0.2)",borderRadius:4,width:28,height:28,cursor:"pointer"}}>✏️</button>
                  <button onClick={()=>setDeleteCat(idx)} style={{background:"rgba(239,68,68,0.1)",color:"var(--accent-crimson-bright)",border:"1px solid rgba(239,68,68,0.2)",borderRadius:4,width:28,height:28,cursor:"pointer"}}>🗑</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ===== COMRADE REMOVAL CONFIRMATIONS ===== */}
      {deleteId!==null&&(
        <div style={{position:"fixed",inset:0,background:"rgba(4,7,11,0.9)",backdropFilter:"blur(2px)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:200}}>
          <div className="modal-content" style={{background:"var(--bg-knight)",borderRadius:4,padding:24,width:"min(90vw,340px)",border:"1px solid var(--accent-crimson)",textAlign:"center",boxShadow:"0 30px 60px rgba(0,0,0,0.9)"}}>
            <div style={{fontSize:32,marginBottom:10}}>⚔️</div>
            <h3 style={{color:"var(--text-silver)",fontFamily:"Cinzel",marginBottom:8,fontSize:16,letterSpacing:0.5}}>PURGE RECORD?</h3>
            <p style={{color:"var(--text-muted)",fontSize:12,marginBottom:20}}>This supply line log will be expunged from the chronicles forever.</p>
            <div style={{display:"flex",gap:10}}>
              <button onClick={()=>setDeleteId(null)} style={{flex:1,background:"var(--surface-falcon)",color:"var(--text-muted)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:600,cursor:"pointer"}}>RETREAT</button>
              <button onClick={()=>{setRows(p=>p.filter(r=>r.id!==deleteId));setDeleteId(null);showToast("🗑️ Log Purged");}} style={{flex:1,background:"var(--accent-crimson)",color:"var(--text-silver)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:700,cursor:"pointer"}}>PURGE</button>
            </div>
          </div>
        </div>
      )}

      {deleteSalId!==null&&(
        <div style={{position:"fixed",inset:0,background:"rgba(4,7,11,0.9)",backdropFilter:"blur(2px)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:200}}>
          <div className="modal-content" style={{background:"var(--bg-knight)",borderRadius:4,padding:24,width:"min(90vw,340px)",border:"1px solid var(--accent-crimson)",textAlign:"center",boxShadow:"0 30px 60px rgba(0,0,0,0.9)"}}>
            <div style={{fontSize:32,marginBottom:10}}>💰</div>
            <h3 style={{color:"var(--text-silver)",fontFamily:"Cinzel",marginBottom:8,fontSize:16,letterSpacing:0.5}}>PURGE TREASURY LOG?</h3>
            <p style={{color:"var(--text-muted)",fontSize:12,marginBottom:20}}>This tribute archive will be dissolved from kingdom records.</p>
            <div style={{display:"flex",gap:10}}>
              <button onClick={()=>setDeleteSalId(null)} style={{flex:1,background:"var(--surface-falcon)",color:"var(--text-muted)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:600,cursor:"pointer"}}>RETREAT</button>
              <button onClick={()=>{setSalaries(p=>p.filter(r=>r.id!==deleteSalId));setDeleteSalId(null);showToast("🗑️ Revenue Purged");}} style={{flex:1,background:"var(--accent-crimson)",color:"var(--text-silver)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:700,cursor:"pointer"}}>PURGE</button>
            </div>
          </div>
        </div>
      )}

      {deleteCat!==null&&(
        <div style={{position:"fixed",inset:0,background:"rgba(4,7,11,0.9)",backdropFilter:"blur(2px)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:200}}>
          <div className="modal-content" style={{background:"var(--bg-knight)",borderRadius:4,padding:24,width:"min(90vw,340px)",border:"1px solid var(--accent-crimson)",textAlign:"center",boxShadow:"0 30px 60px rgba(0,0,0,0.9)"}}>
            <div style={{fontSize:32,marginBottom:10}}>🦅</div>
            <h3 style={{color:"var(--text-silver)",fontFamily:"Cinzel",marginBottom:8,fontSize:15,letterSpacing:0.5}}>DISBAND DIVISION "{cats[deleteCat]?.name.toUpperCase()}"?</h3>
            <p style={{color:"var(--text-muted)",fontSize:12,marginBottom:20}}>The division group will fall. Items tied to this rank will remain unassigned.</p>
            <div style={{display:"flex",gap:10}}>
              <button onClick={()=>setDeleteCat(null)} style={{flex:1,background:"var(--surface-falcon)",color:"var(--text-muted)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:600,cursor:"pointer"}}>RETREAT</button>
              <button onClick={()=>{setCats(p=>p.filter((_,i)=>i!==deleteCat));setDeleteCat(null);showToast("🗑️ Division Disbanded");}} style={{flex:1,background:"var(--accent-crimson)",color:"var(--text-silver)",border:"none",borderRadius:4,padding:"11px 0",fontSize:13,fontWeight:700,cursor:"pointer"}}>DISBAND</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script>
</body>
</html>
