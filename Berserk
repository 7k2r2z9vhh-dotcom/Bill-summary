<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Duchanee Ledger - Falconia Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Cormorant+Garamond:ital,wght@0,500;0,700;1,400&family=Sarabun:wght@400;600;700&display=swap" rel="stylesheet"/>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
  :root{
    --bg-dark: #060b11;
    --bg-knight: #0b1420;
    --surface-falcon: #111e30;
    --surface-hawk: #172a43;
    --border-steel: #2c4260;
    --border-gold: #aa842c;
    --hawk-blue: #1e3a8a;
    --hawk-gold: #d4af37;
    --hawk-gold-glow: rgba(212,175,55,0.2);
    --text-silver: #f5f7fa;
    --text-muted: #8fa0b5;
    --accent-crimson: #991b1b;
    --accent-crimson-bright: #ef4444;
    --accent-emerald: #10b981;
  }
  *{box-sizing:border-box;margin:0;padding:0}

  body{
    background: var(--bg-dark);
    min-height: 100vh;
    font-family: 'Sarabun', 'Cormorant Garamond', serif;
    color: var(--text-silver);
    background-image:
      radial-gradient(ellipse 70% 60% at 50% -10%, rgba(30,58,138,0.25) 0%, transparent 70%),
      radial-gradient(circle at 90% 80%, rgba(212,175,55,0.05) 0%, transparent 40%),
      url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 0 L43 25 L68 28 L45 40 L52 65 L40 50 L28 65 L35 40 L12 28 L37 25 Z' fill='none' stroke='%23aa842c' stroke-width='0.2' opacity='0.08'/%3E%3C/svg%3E");
  }

  /* Steel Shimmer Top Line */
  body::after{
    content:'';position:fixed;top:0;left:0;right:0;height:2px;
    background:linear-gradient(90deg, transparent, var(--text-silver), var(--hawk-gold), var(--text-silver), transparent);
    z-index:100;
  }

  input, select, button { font-family: 'Sarabun', sans-serif; }

  ::-webkit-scrollbar{width:5px}
  ::-webkit-scrollbar-track{background:var(--bg-dark)}
  ::-webkit-scrollbar-thumb{background:var(--border-gold);border-radius:3px}

  /* Falcon Cards styling */
  .month-card{
    background: linear-gradient(135deg, var(--surface-falcon), var(--bg-knight));
    border: 1px solid var(--border-steel);
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    cursor: pointer;
    overflow: hidden;
  }
  .month-card::before {
    content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(245,247,250,0.08), transparent);
    transition: all 0.6s ease;
  }
  .month-card:hover{
    transform: translateY(-4px);
    border-color: var(--hawk-gold);
    box-shadow: 0 10px 25px rgba(212,175,55,0.15), inset 0 0 12px rgba(212,175,55,0.05);
  }
  .month-card:hover::before { left: 150%; }

  .nav-tab{
    transition: all 0.3s ease;
    font-family: 'Cinzel', serif;
    letter-spacing: 2px;
  }

  .row-item{transition: background 0.2s ease}
  .row-item:hover{background: rgba(212,175,55,0.04)!important}

  /* Cinematic Title text */
  .app-title{
    font-family: 'Cinzel', serif;
    font-size: 26px; font-weight: 900; letter-spacing: 8px;
    background: linear-gradient(135deg, var(--text-silver) 30%, var(--hawk-gold) 70%, var(--text-silver));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-shadow: 0 0 20px rgba(212,175,55,0.2);
  }
  
  .app-subtitle{
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px; font-style: italic; letter-spacing: 3px; color: var(--text-muted);
    margin-top: 4px; font-weight: 500;
  }

  /* Knight Shield Buttons */
  .btn-primary{
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--border-gold), var(--hawk-gold));
    color: var(--bg-dark) !important; font-weight: 700;
    border: 1px solid var(--hawk-gold);
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px var(--hawk-gold-glow);
  }
  .btn-primary:hover{
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(212,175,55,0.4);
    filter: brightness(1.1);
  }

  .falcon-divider {
    display: flex; align-items: center; justify-content: center; gap: 15px; margin: 12px 0;
  }
  .falcon-divider::before, .falcon-divider::after {
    content: ''; flex: 1; max-width: 120px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-gold));
  }
  .falcon-divider::after { background: linear-gradient(90deg, var(--border-gold), transparent); }

  /* Guts Sword Divider for sections */
  .sword-pointer {
    font-family: 'Cinzel', serif; color: var(--hawk-gold); font-size: 11px; letter-spacing: 1px;
  }

  .mono { font-family: 'Cinzel', serif; }
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const { useState, useMemo, useEffect } = React;

const SK  = "bill_data", SI = "bill_nextid", SC = "bill_cats", SS = "bill_salary";
const defaultCats = [
  {name:"Carry Over Y68",color:"#d4af37"},{name:"Repair",color:"#991b1b"},
  {name:"Worker House",color:"#6366f1"},{name:"Materials",color:"#2563eb"},
  {name:"Utilities",color:"#10b981"},{name:"Internet",color:"#06b6d4"},{name:"Others",color:"#64748b"},
];
const defaultData = [
  {id:1,date:"6/1/69",amount:15000,deduct:0,description:"ค่าล้อสัมภาระ ปี 68",category:"Carry Over Y68"},
  {id:2,date:"16/1/69",amount:1926,deduct:0,description:"กา. คุณหมาเครื่องตู้หน้า 2H",category:"Repair"},
  {id:3,date:"16/1/69",amount:153,deduct:0,description:"สร. Worker House",category:"Worker House"},
  {id:4,date:"19/1/69",amount:1920,deduct:0,description:"สร. เหล็กเพิ่ก บนปลวก หน้าหม้อน้ำ",category:"Materials"},
  {id:5,date:"23/1/69",amount:2400,deduct:0,description:"แม่สร. น้ำ + ไฟ",category:"Utilities"},
  {id:6,date:"23/1/69",amount:26.75,deduct:0,description:"สร. ไฟ",category:"Utilities"},
  {id:7,date:"10/2/69",amount:92.68,deduct:0,description:"สร. ไฟ",category:"Utilities"},
  {id:8,date:"12/2/69",amount:900,deduct:0,description:"สร. เหล็กสแลกลูก ๓จุก บนปลวกหม้อน้ำ",category:"Materials"},
  {id:9,date:"13/2/69",amount:1201.90,deduct:0,description:"สร. Net Php54",category:"Internet"},
  {id:10,date:"13/2/69",amount:2068,deduct:0,description:"สร. Net",category:"Internet"},
  {id:11,date:"21/2/69",amount:3010,deduct:0,description:"ค่าน้ำ + ไฟ",category:"Utilities"},
];
const PRESET_COLORS=["#d4af37","#991b1b","#3b82f6","#10b981","#6366f1","#06b6d4","#f43f5e","#ec4899","#eab308","#14b8a6","#a855f7","#64748b"];
const MONTH_FULL=["","January","February","March","April","May","June","July","August","September","October","November","December"];
const MONTH_SHORT=["","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const fmt=n=>Number(n).toLocaleString("th-TH",{minimumFractionDigits:2,maximumFractionDigits:2});
function load(k,d){try{const s=localStorage.getItem(k);return s?JSON.parse(s):d;}catch(e){return d;}}
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
function pm(d){return parseInt(d.split("/")[1]);}
function py(d){return parseInt(d.split("/")[2]);}

// ---- PDF Engine with Medieval Styling ----
async function exportPDF(data, title, isSalary=false) {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({orientation:"landscape",unit:"mm",format:"a4"});

  // Draw Deep Hawk Navy Header block
  doc.setFillColor(11,20,32);
  doc.rect(0,0,297,22,"F");
  doc.setDrawColor(212,175,55);
  doc.setLineWidth(0.5);
  doc.line(0,22,297,22);

  async function thaiText(text, fontSize, color="#ffffff") {
    const canvas = document.createElement("canvas");
    const scale = 3;
    canvas.width = 2000; canvas.height = fontSize * scale * 2;
    const ctx = canvas.getContext("2d");
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.font = `bold ${fontSize*scale}px Sarabun, sans-serif`;
    ctx.fillStyle = color;
    ctx.fillText(text, 0, fontSize*scale*1.2);
    const w = ctx.measureText(text).width;
    const trimmed = document.createElement("canvas");
    trimmed.width = Math.ceil(w)+4; trimmed.height = canvas.height;
    trimmed.getContext("2d").drawImage(canvas,0,0);
    return {dataUrl: trimmed.toDataURL("image/png"), w: Math.ceil(w)/scale, h: fontSize*2.4};
  }

  let t = await thaiText(title.toUpperCase(), 14, "#d4af37");
  doc.addImage(t.dataUrl,"PNG",14,3,Math.min(t.w,200),t.h*0.6);
  t = await thaiText(isSalary?"THE TACTICAL SALARY LEDGER":"EXPENSE TACTICS CHRONICLE", 9, "#8fa0b5");
  doc.addImage(t.dataUrl,"PNG",14,13,Math.min(t.w,200),t.h*0.55);

  if(isSalary) {
    const heads = [["#","Campaign Month","Strategic Expected","Actual Paid","Variance","Tactical Note"]];
    const body = data.map((r,i)=>{
      const diff = Number(r.paid) - Number(r.expected);
      return [i+1, `${MONTH_FULL[r.month]} 20${r.year}`, fmt(r.expected), fmt(r.paid), diff>=0?`+${fmt(diff)}`:fmt(diff), r.note||""];
    });
    const tE=data.reduce((s,r)=>s+Number(r.expected),0);
    const tP=data.reduce((s,r)=>s+Number(r.paid),0);
    body.push(["","","GRAND CORPS TOTAL",fmt(tE),fmt(tP),""]);
    doc.autoTable({startY:28,head:heads,body,
      styles:{fontSize:10,cellPadding:4.5,font:"Helvetica"},
      headStyles:{fillColor:[23,42,67],textColor:[212,175,55],fontStyle:"bold"},
      alternateRowStyles:{fillColor:[240,244,248]},
      columnStyles:{0:{cellWidth:10,halign:"center"},2:{halign:"right"},3:{halign:"right"},4:{halign:"right"}},
      didParseCell:(d)=>{if(d.row.index===data.length){d.cell.styles.fontStyle="bold";d.cell.styles.fillColor=[212,175,55];d.cell.styles.textColor=[11,20,32];}}
    });
  } else {
    const tA=data.reduce((s,r)=>s+Number(r.amount),0);
    const tD=data.reduce((s,r)=>s+Number(r.deduct||0),0);
    const tN=tA-tD;
    const body=[...data.map((r,i)=>[i+1,r.date,r.description,r.category,fmt(r.amount),Number(r.deduct||0)>0?fmt(r.deduct):"-",fmt(Number(r.amount)-Number(r.deduct||0))]),
      ["","","","GRAND CAMPAIGN TOTAL",fmt(tA),tD>0?fmt(tD):"-",fmt(tN)]];
    doc.autoTable({startY:28,
      head:[["#","Deployment Date","Supplies / Items","Division Category","Amount","Deduction","Net Resource"]],
      body,
      styles:{fontSize:9,cellPadding:4},
      headStyles:{fillColor:[23,42,67],textColor:[212,175,55],fontStyle:"bold"},
      alternateRowStyles:{fillColor:[242,245,249]},
      columnStyles:{0:{cellWidth:10,halign:"center"},1:{cellWidth:24},2:{cellWidth:80},3:{cellWidth:32},4:{cellWidth:30,halign:"right"},5:{cellWidth:30,halign:"right"},6:{cellWidth:30,halign:"right"}},
      didParseCell:(d)=>{if(d.row.index===data.length){d.cell.styles.fontStyle="bold";d.cell.styles.fillColor=[212,175,55];d.cell.styles.textColor=[11,20,32];}}
    });
  }
  doc.save(`${title}.pdf`);
}

function App(){
  const [rows,setRows]     = useState(()=>load(SK,defaultData));
  const [nextId,setNextId] = useState(()=>load(SI,12));
  const [cats,setCats]     = useState(()=>load(SC,defaultCats));
  const [salaries,setSalaries] = useState(()=>load(SS,[]));
  const [tab,setTab]       = useState("expense"); 
  const [view,setView]     = useState("summary");
  const [showModal,setShowModal]       = useState(false);
  const [showCatModal,setShowCatModal] = useState(false);
  const [showSalModal,setShowSalModal] = useState(false);
  const [editRow,setEditRow]   = useState(null);
  const [editSal,setEditSal]   = useState(null);
  const [form,setForm]         = useState({date:"1/1/69",amount:"",deduct:"",description:"",category:""});
  const [salForm,setSalForm]   = useState({month:1,year:69,expected:"",paid:"",note:""});
  const [deleteId,setDeleteId] = useState(null);
  const [deleteSalId,setDeleteSalId] = useState(null);
  const [catForm,setCatForm]   = useState({name:"",color:"#d4af37"});
  const [editCat,setEditCat]   = useState(null);
  const [deleteCat,setDeleteCat] = useState(null);
  const [toast,setToast]       = useState("");

  useEffect(()=>save(SK,rows),[rows]);
  useEffect(()=>save(SI,nextId),[nextId]);
  useEffect(()=>save(SC,cats),[cats]);
  useEffect(()=>save(SS,salaries),[salaries]);

  const catMap = useMemo(()=>{const m={};cats.forEach(c=>m[c.name]=c.color);return m;},[cats]);
  const showToast = msg=>{setToast(msg);setTimeout(()=>setToast(""),2000);};

  const monthGroups = useMemo(()=>{
    const map={};
    rows.forEach(r=>{const key=`${pm(r.date)}/${py(r.date)}`;if(!map[key])map[key]={month:pm(r.date),year:py(r.date),key,rows:[]};map[key].rows.push(r);});
    return Object.values(map).sort((a,b)=>a.year!==b.year?a.year-b.year:a.month-b.month);
  },[rows]);

  const totalAmount=rows.reduce((s,r)=>s+Number(r.amount),0);
  const totalDeduct=rows.reduce((s,r)=>s+Number(r.deduct||0),0);
  const totalNet=totalAmount-totalDeduct;

  const openAdd  = ()=>{setForm({date:"1/1/69",amount:"",deduct:"",description:"",category:cats[0]?.name||""});setEditRow(null);setShowModal(true);};
  const openEdit = r=>{setForm({date:r.date,amount:r.amount,deduct:r.deduct||0,description:r.description,category:r.category});setEditRow(r.id);setShowModal(true);};
  const saveForm = ()=>{
    if(!form.date||(!form.amount&&!form.deduct)||!form.description)return;
    if(editRow!==null){setRows(p=>p.map(r=>r.id===editRow?{...r,...form,amount:Number(form.amount||0),deduct:Number(form.deduct||0)}:r));showToast("⚔️ Deployment updated");}
    else{setRows(p=>[...p,{id:nextId,...form,amount:Number(form.amount||0),deduct:Number(form.deduct||0)}]);setNextId(p=>p+1);showToast("⚔️ Added to Ledger");}
    setShowModal(false);
  };

  const openAddSal  = ()=>{setSalForm({month:1,year:69,expected:"",paid:"",note:""});setEditSal(null);setShowSalModal(true);};
  const openEditSal = r=>{setSalForm({month:r.month,year:r.year,expected:r.expected,paid:r.paid,note:r.note||""});setEditSal(r.id);setShowSalModal(true);};
  const saveSalForm = ()=>{
    if(!salForm.expected||!salForm.paid)return;
    if(editSal!==null){setSalaries(p=>p.map(r=>r.id===editSal?{...r,...salForm,expected:Number(salForm.expected),paid:Number(salForm.paid)}:r));showToast("🦅 Ranks Updated");}
    else{setSalaries(p=>[...p,{id:Date.now(),...salForm,expected:Number(salForm.expected),paid:Number(salForm.paid)}]);showToast("🦅 Month coffers added");}
    setShowSalModal(false);
  };

  const openEditCat = i=>{setCatForm({name:cats[i].name,color:cats[i].color});setEditCat(i);};
  const saveCat = ()=>{
    if(!catForm.name.trim())return;
    if(editCat!==null){const old=cats[editCat].name;setCats(p=>p.map((c,idx)=>idx===editCat?{...catForm}:c));setRows(p=>p.map(r=>r.category===old?{...r,category:catForm.name}:r));showToast("🏷️ Division altered");}
    else{if(cats.find(c=>c.name===catForm.name.trim()))return;setCats(p=>[...p,{name:catForm.name.trim(),color:catForm.color}]);showToast("🏷️ New Regiment added");}
    setEditCat(null);setCatForm({name:"",color:"#d4af37"});
  };

  const currentMonthKey   = view.startsWith("month:")?view.replace("month:",""):null;
  const currentMonthGroup = currentMonthKey?monthGroups.find(g=>g.key===currentMonthKey):null;
  const detailRows        = currentMonthGroup?currentMonthGroup.rows:rows;
  const colGrid = "40px 88px 1fr 120px 95px 95px 95px 70px";

  function CatBadge({name}){const color=catMap[name]||"#64748b";return <span style={{background:`${color}12`,color,borderRadius:2,padding:"3px 8px",fontSize:10,fontWeight:600,border:`1px solid ${color}55`,textTransform:"uppercase",letterSpacing:"1px"}}>{name}</span>;}

  function DateDropdown({value,onChange}){
    const parts=(value||"1/1/69").split("/");
    const dd=parts[0]||"1",mm=parts[1]||"1",yy=parts[2]||"69";
    const set=(d,m,y)=>onChange(`${d}/${m}/${y}`);
    const sel={background:"var(--bg-knight)",border:"1px solid var(--border-steel)",borderRadius:4,padding:"10px",color:"var(--text-silver)",fontSize:14,outline:"none",cursor:"pointer"};
    return(
      <div style={{marginBottom:14}}>
        <label style={{color:"var(--text-muted)",fontSize:11,textTransform:"uppercase",letterSpacing:1,display:"block",marginBottom:6}}>Deployment Date</label>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1.5fr 1fr",gap:8}}>
          <select value={dd} onChange={e=>set(e.target.value,mm,yy)} style={sel}>{Array.from({length:31},(_,i)=><option key={i+1} value={i+1}>{i+1}</option>)}</select>
          <select value={mm} onChange={e=>set(dd,e.target.value,yy)} style={sel}>{MONTH_SHORT.slice(1).map((m,i)=><option key={i+1} value={i+1}>{m}</option>)}</select>
          <select value={yy} onChange={e=>set(dd,mm,e.target.value)} style={sel}>{[{v:67,l:2024},{v:68,l:2025},{v:69,l:2026},{v:70,l:2027},{v:71,l:2028},{v:72,l:2029}].map(({v,l})=><option key={v} value={v}>{l}</option>)}</select>
        </div>
      </div>
    );
  }

  function RowTable({data,pdfTitle}){
    const tA=data.reduce((s,r)=>s+Number(r.amount),0);
    const tD=data.reduce((s,r)=>s+Number(r.deduct||0),0);
    const tN=tA-tD;
    return(<>
      <div style={{display:"flex",justifyContent:"flex-end",marginBottom:14}}>
        <button onClick={()=>exportPDF(data,pdfTitle)} style={{background:"var(--surface-hawk)",color:"var(--hawk-gold)",border:"1px solid var(--border-gold)",borderRadius:4,padding:"10px 20px",fontSize:12,fontWeight:600,letterSpacing:1,cursor:"pointer",display:"flex",alignItems:"center",gap:8}}>🦅 EXPORT WAR RECORD (PDF)</button>
      </div>
      <div style={{background:"var(--bg-knight)",borderRadius:4,border:"1px solid var(--border-steel)",overflowX:"auto"}}>
        <div style={{display:"grid",gridTemplateColumns:colGrid,padding:"12px 16px",background:"var(--surface-falcon)",color:"var(--hawk-gold)",fontSize:11,fontWeight:700,letterSpacing:1.5,textTransform:"uppercase",borderBottom:"1px solid var(--border-steel)",minWidth:750}}>
          <div>#</div><div>Date</div><div>Strategic Item</div><div>Division</div><div style={{textAlign:"right"}}>Gross</div><div style={{textAlign:"right",color:"var(--accent-crimson-bright)"}}>Deduct</div><div style={{textAlign:"right",color:"var(--accent-emerald)"}}>Net Coffers</div><div style={{textAlign:"center"}}>Tactics</div>
        </div>
        {data.map((r,i)=>{const net=Number(r.amount)-Number(r.deduct||0);return(
          <div key={r.id} className="row-item" style={{display:"grid",gridTemplateColumns:colGrid,padding:"12px 16px",alignItems:"center",borderBottom:"1px solid var(--border-steel)",background:i%2===0?"transparent":"rgba(255,255,255,0.01)",minWidth:750}}>
            <div style={{color:"var(--text-muted)",fontSize:12}}>{i+1}</div>
            <div style={{color:"var(--text-muted)",fontSize:12}}>{r.date}</div>
            <div style={{color:"var(--text-silver)",fontSize:13,fontWeight:500}}>{r.description}</div>
            <div><CatBadge name={r.category}/></div>
            <div style={{color:"var(--text-silver)",fontSize:13,fontWeight:600,textAlign:"right"}}>฿{fmt(r.amount)}</div>
            <div style={{color:Number(r.deduct||0)>0?"var(--accent-crimson-bright)":"var(--text-muted)",fontSize:13,fontWeight:600,textAlign:"right"}}>{Number(r.deduct||0)>0?`-฿${fmt(r.deduct)}`:"-"}</div>
            <div style={{color:"var(--accent-emerald)",fontSize:13,fontWeight:700,textAlign:"right"}}>฿{fmt(net)}</div>
            <div style={{display:"flex",gap:6,justifyContent:"center"}}>
              <button onClick={()=>openEdit(r)} style={{background:"var(--surface-falcon)",color:"#60a5fa",border:"1px solid rgba(96,165,250,0.3)",borderRadius:4,width:28,height:28,cursor:"pointer"}}>✏️</button>
              <button onClick={()=>setDeleteId(r.id)} style={{background:"rgba(239,68,68,0.1)",color:"var(--accent-crimson-bright)",border:"1px solid rgba(239,68,68,0.3)",borderRadius:4,width:28,height:28,cursor:"pointer"}}>🗑</button>
            </div>
          </div>
        );})}
        <div style={{display:"grid",gridTemplateColumns:colGrid,padding:"14px 16px",background:"var(--surface-falcon)",borderTop:"2px solid var(--border-gold)",minWidth:750}}>
